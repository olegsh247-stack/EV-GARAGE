NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://ev:ev@127.0.0.1:5432/ev_garage
# Host port published by docker compose. Use another value if 5432 is already taken.
POSTGRES_PORT=5432
ADMIN_PASSWORD=change-me
PHOTOS_DIR=./data/photos

# Used by `docker compose --profile full` on the single host.
# DATABASE_URL inside that compose network uses host name `postgres`, not 127.0.0.1.
POSTGRES_USER=ev
POSTGRES_PASSWORD=ev
POSTGRES_DB=ev_garage

# Public site for Caddy. Use :80 until DNS points at the server, then the domain name.
SITE_ADDRESS=:80

# GitHub Actions passes IMAGE_TAG (the commit sha) when it starts the published image.
# Do not put a secret here. Local `docker compose up -d postgres` does not need it.
